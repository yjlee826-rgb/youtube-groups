{
  "manifest_version": 3,
  "name": "다락",
  "version": "1.1.0",
  "description": "툴바 아이콘으로 다락을 탭에서 열고, 다락에서 누른 채널과 영상은 열려 있는 유튜브 탭 하나에서 엽니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "다락 열기"
  },
  "permissions": [],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://yjlee826-rgb.github.io/*"
    ]
  }
}