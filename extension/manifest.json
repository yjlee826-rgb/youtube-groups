{
  "manifest_version": 3,
  "name": "다락",
  "version": "1.0.0",
  "description": "크롬 옆 패널에 다락을 띄우고, 누른 채널과 영상은 옆의 유튜브 탭에서 엽니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "다락 열기"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "key": ""
}